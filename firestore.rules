rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wedding_gifts/{giftId} {
      allow read: if true;
      allow create: if request.resource.data.claimed == true
                    && request.resource.data.keys().hasOnly(['claimed', 'claimedAt']);
      allow update: if resource.data.claimed != true
                    && request.resource.data.claimed == true;
      allow delete: if false;
    }
  }
}
